# Copia in .env e compila. Node 22 lo carica da solo (--env-file-if-exists).

PORT=4310
NODE_ENV=production
# Stringa lunga e casuale: firma i cookie di sessione
SESSION_SECRET=

# ---------------------------------------------------------------- Dati
# "postgres"  = database PostgreSQL (default se DATABASE_URL è impostata)
# "firestore" = stesso progetto Firebase dell'app FlutterFlow originale
# "memory"    = demo locale su data/db.json (default se non c'è altro)
DATA_DRIVER=postgres

# Il database viene creato al primo avvio se l'utente ha il permesso CREATEDB;
# lo schema (tabelle, vincoli, indici) viene applicato a ogni avvio.
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/santaniello_crm

# ---------------------------------------------------------------- Firebase
# Necessario solo con DATA_DRIVER=firestore o per "npm run db:import -- --from=firestore"

# Credenziali service account (una delle due):
#   GOOGLE_APPLICATION_CREDENTIALS=C:\percorso\service-account.json
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
GOOGLE_APPLICATION_CREDENTIALS=

FIREBASE_PROJECT_ID=santantanielloe-associa-ltshyc
FIREBASE_STORAGE_BUCKET=santantanielloe-associa-ltshyc.firebasestorage.app
# Chiave Web API (Console Firebase → Impostazioni progetto): serve per login/registrazione email+password
FIREBASE_WEB_API_KEY=

# ---------------------------------------------------------------- Ricerca
# Se vuote si usa una ricerca testuale locale al posto di Algolia
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=
